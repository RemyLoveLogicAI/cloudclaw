# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot (strongly recommended)
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_PARSE_MODE=plain
TELEGRAM_SHOW_TELEMETRY=1
HISTORY_TURNS=12
SYSTEM_PROMPT=You are CloudClaw, an autonomous cloud-routed AI assistant. Be concise and direct.

# --- Providers (set at least one) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
VENICE_API_KEY=
VENICE_MODEL=venice-uncensored
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# --- Optional MCP tool server ---
MCP_COMMAND=
MCP_ARGS=
